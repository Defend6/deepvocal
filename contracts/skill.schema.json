{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deepvocal:skill:1.0",
  "type": "object",
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "allowed_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "knowledge",
          "assessment",
          "planning",
          "singing"
        ]
      }
    },
    "required_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+[.][a-z_]+$"
      }
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "reviewed",
        "published",
        "retired",
        "rejected"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "skill_id",
    "name",
    "version",
    "description",
    "triggers",
    "allowed_agents",
    "required_tools",
    "input_schema",
    "output_schema",
    "risk_level",
    "status",
    "content_hash"
  ],
  "additionalProperties": false
}
