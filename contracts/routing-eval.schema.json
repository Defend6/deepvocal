{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deepvocal:routing-eval:1.2",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "string",
      "enum": [
        "single_agent_baseline",
        "langgraph_multiagent"
      ]
    },
    "expected_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "knowledge",
          "assessment",
          "planning",
          "singing"
        ]
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_handoff": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_resource_state": {
      "type": "string",
      "enum": [
        "ready",
        "missing",
        "invalid",
        "unowned"
      ]
    },
    "completion_criteria": {
      "type": "string",
      "minLength": 1
    },
    "should_clarify": {
      "type": "boolean"
    },
    "clarification": {
      "type": "boolean"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "enum": [
              "single",
              "knowledge",
              "assessment",
              "planning",
              "singing"
            ]
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "params_valid": {
            "type": "boolean"
          },
          "resource_allowed": {
            "type": "boolean"
          },
          "preconditions_met": {
            "type": "boolean"
          },
          "executed": {
            "type": "boolean"
          }
        },
        "required": [
          "agent",
          "tool",
          "params_valid",
          "resource_allowed",
          "preconditions_met",
          "executed"
        ],
        "additionalProperties": false
      }
    },
    "task_pass": {
      "type": "boolean"
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "configuration",
    "expected_agents",
    "allowed_tools",
    "expected_handoff",
    "input_resource_state",
    "completion_criteria",
    "should_clarify",
    "clarification",
    "tool_calls",
    "task_pass",
    "synthetic"
  ],
  "additionalProperties": false
}
