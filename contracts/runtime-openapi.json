  "components": {
    "schemas": {
      "AssistantRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input"
          },
          "input_asset_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Asset Id"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "idempotency_key"
        ],
        "title": "AssistantRequest"
      },
      "AuthUserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "issuer": {
            "type": "string",
            "title": "Issuer"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          }
        },
        "type": "object",
        "required": [
          "id",
          "issuer",
          "subject"
        ],
        "title": "AuthUserResponse"
      },
      "Candidate": {
        "properties": {
          "agent": {
            "type": "string",
            "enum": [
              "knowledge",
              "assessment",
              "planning",
              "singing"
            ],
            "title": "Agent"
          },
          "skill_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,50}$",
            "title": "Skill Id"
          },
          "steps": {
            "items": {
              "type": "string",
              "enum": [
                "evidence",
                "quality",
                "coverage",
                "constraints",
                "feedback",
                "capabilities"
              ]
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Steps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent",
          "skill_id",
          "steps"
        ],
        "title": "Candidate"
      },
      "CapabilityResponse": {
        "properties": {
          "agent": {
            "type": "string",
