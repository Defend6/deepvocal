{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deepvocal:route:1.1",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "route",
        "clarify"
      ]
    },
    "primary_intent": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "knowledge",
        "assessment",
        "planning",
        "singing",
        null
      ]
    },
    "requested_intents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "knowledge",
          "assessment",
          "planning",
          "singing"
        ]
      },
      "uniqueItems": true,
      "maxItems": 4
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "INPUT_QUESTION",
        "AUDIO_ASSESSMENT",
        "PRACTICE_PLAN",
        "SINGING_REQUEST",
        "MIXED_REQUEST",
        "NEED_CLARIFICATION"
      ]
    }
  },
  "required": [
    "decision",
    "primary_intent",
    "requested_intents",
    "confidence",
    "missing_fields",
    "reason_code"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "clarify"
          }
        }
      },
      "then": {
        "properties": {
          "primary_intent": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "primary_intent": {
            "type": "string",
            "enum": [
              "knowledge",
              "assessment",
              "planning",
              "singing"
            ]
          }
        }
      }
    }
  ]
}
