{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future private practice event; no records collected",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "exercise_ref": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "report_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "self_reported_effort": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 10
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "consent_purpose": {
      "const": "personal_practice_assistance"
    },
    "visibility": {
      "const": "private"
    }
  },
  "required": [
    "event_id",
    "owner_id",
    "occurred_at",
    "exercise_ref",
    "duration_seconds",
    "consent_purpose",
    "visibility"
  ]
}
