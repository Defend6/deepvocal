DEEPVOCAL_MODE=mock
AUTH_MODE=local
# Reserved configuration only; OIDC is not implemented in this stage.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
AUTH_CLOCK_SKEW_SECONDS=30
MAX_AUDIO_SIZE_BYTES=104857600
UPLOAD_EXPIRY_SECONDS=3600
API_HOST=127.0.0.1
API_PORT=8000
POSTGRES_PORT=15432
REDIS_PORT=16379
DATABASE_URL=postgresql+asyncpg://deepvocal:deepvocal@127.0.0.1:15432/deepvocal
REDIS_URL=redis://127.0.0.1:16379/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=deepvocal-private
S3_ACCESS_KEY=deepvocal
S3_SECRET_KEY=change-me-local-only
# Local-only default matching Compose; rotate before using any non-local data.
RUSTFS_SSE_S3_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only
MILVUS_URI=http://127.0.0.1:19530
MODEL_PROVIDER=openai-compatible
MODEL_API_BASE=https://api.siliconflow.cn/v1
# For Docker containers use host.docker.internal; native Windows processes use 127.0.0.1.
EMBEDDING_API_BASE=http://host.docker.internal:11434/v1
RERANKER_API_BASE=http://host.docker.internal:18081
# For Ollama set EMBEDDING_MODEL=bge-m3:latest; revision is the /api/tags digest.
EMBEDDING_MODEL_REVISION=
RERANKER_MODEL_REVISION=
MODEL_API_KEY=
# Set false only when intentionally accepting unmetered provider calls.
MODEL_BUDGET_ENFORCED=true
# CNY fen per month; zero disables every paid request. No live prices are assumed.
MODEL_MONTHLY_LIMIT_MINOR=0
MODEL_BILLING_VERIFIED=false
# JSON keyed by exact model id; rates are CNY fen per 1,000,000 tokens.
# Include both input_minor_per_million and output_minor_per_million for all 3 models.
MODEL_PRICES_JSON={}
# Decoder runs in a separate process; local temporary root defaults to runtime/audio.
AUDIO_PROCESS_TIMEOUT_SECONDS=90
AUDIO_PROCESS_MEMORY_MIB=1536
CHAT_MODEL=Qwen/Qwen3-8B
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
KNOWLEDGE_MODE=research
# Docker mounts this ignored local directory read-only; no corpus is baked into images.
# DEEPVOCAL_CORPUS_DIR=D:/deepvocal/datasets
SINGING_ENABLED=false
SINGING_SERVICE_URL=http://127.0.0.1:8090
SINGING_CONTAINER_SERVICE_URL=http://host.docker.internal:8090
SINGING_SERVICE_TOKEN=
METRICS_TOKEN=
REQUEST_LIMIT_PER_MINUTE=120
JOBS_DAILY_LIMIT=100
JOBS_CONCURRENT_LIMIT=5
OIDC_CLIENT_ID=deepvocal-web
IDENTITY_ADMIN_USER=admin
IDENTITY_ADMIN_PASSWORD=
# OIDC mode uses access tokens. Local Keycloak test configuration:
# AUTH_MODE=oidc
# OIDC_ISSUER=http://127.0.0.1:8180/realms/deepvocal
# OIDC_AUDIENCE=deepvocal-api
# OIDC_JWKS_URL=http://identity:8180/realms/deepvocal/protocol/openid-connect/certs
